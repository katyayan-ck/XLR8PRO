includes:
    - vendor/larastan/larastan/extension.neon
    # Known errors in legacy code (to-do W4, 30-09-2026): new code must not add any. Regenerate only after fixing
    # recorded errors (composer analyse -- --generate-baseline phpstan-baseline.neon), never to hide new ones.
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes
    excludePaths:
        # dead backup copies (never autoloaded); its duplicate App\Models\User confused Larastan (BUG-140)
        - app/Models_backup (?)
    level: 5
    phpVersion: 80300
    parallel:
        maximumNumberOfProcesses: 1