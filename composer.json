{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bmpl/xceler8",
    "type": "project",
    "description": "Xceler8 — BMPL dealership management system (enquiry, quotation, booking, pricing, org/IAM).",
    "keywords": [
        "dms",
        "dealership",
        "laravel",
        "backpack"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "backpack/crud": "^7.0",
        "backpack/theme-tabler": "^2.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "darkaonline/l5-swagger": "^9.0",
        "google/apiclient": "^2.19",
        "google/cloud-vision": "^2.1",
        "kalnoy/nestedset": "^6.0",
        "kreait/firebase-php": "^7.24",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^3.1",
        "owen-it/laravel-auditing": "^14.0",
        "revolution/laravel-google-sheets": "^7.2",
        "spatie/laravel-medialibrary": "^11.17",
        "spatie/laravel-permission": "^6.23"
    },
    "require-dev": {
        "backpack/generators": "^4.1",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.9",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "petebishwhip/laradocs": "^1.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "exclude-from-classmap": [
            "vendor/laravel/pint/app/",
            "vendor/league/flysystem/src/Local/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "lint": "pint --dirty",
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php artisan basset:cache"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan basset:cache"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "google/apiclient-services": [
            "Drive",
            "Sheets"
        ],
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
